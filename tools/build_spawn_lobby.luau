local PORTAL_TRIGGER = V(-0.00, 20.00, 80.00)

-- Onde a ilha fica: praça com o piso em y = 1 (mesmo nível do palco), bem a oeste do palco (~380 studs de vão),
-- girada para o portal apontar para o palco (+X). Mudou aqui? Ajuste Config.Social.SpawnIsland.
local PIVOT = CFrame.new(-550, 1, 0) * CFrame.Angles(0, math.rad(90), 0)
-- Centro da caixa do conjunto exportado, em coordenadas locais (confere com o .blend).
local LOCAL_BOUNDS_CENTER = V(-0.5, 13.65, -6.5)

local WALL_HEIGHT = 9 -- da base da grade até acima do pulo (pulo ~7,2)
local WALL_THICKNESS = 0.6

local lobby = workspace:FindFirstChild("SpawnLobby")
if not lobby then
	local scene = workspace:FindFirstChild("Scene")
	assert(scene and scene:IsA("Model"), "Importe HyperShow_Lobby_Geral.glb primeiro (workspace.Scene)")
	local center = scene:GetBoundingBox().Position
	scene.WorldPivot = CFrame.new(center - LOCAL_BOUNDS_CENTER)
	scene:PivotTo(PIVOT)
	scene.Name = "Visual"
	lobby = Instance.new("Model")
	lobby.Name = "SpawnLobby"
	lobby.Parent = workspace
	scene.Parent = lobby
end
assert(lobby and lobby:IsA("Model"))
lobby.WorldPivot = PIVOT
lobby.Visual:PivotTo(PIVOT) -- o Visual tem o pivô na origem da ilha
for _, name in { "Colliders", "Spawns", "PortalTrigger" } do
	local old = lobby:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

-- O importador não traz as cores: materiais do .blend (cores lineares do glTF, convertidas para sRGB).
-- A ordem importa: nomes mais específicos primeiro ("NEON_Ciano.001" antes de "NEON_Ciano").
local NEON, SMOOTH = Enum.Material.Neon, Enum.Material.SmoothPlastic
local MATERIALS: { { key: string, color: { number }, material: Enum.Material, reflectance: number?, transparency: number? } } = {
	{ key = "NEON_Ciano.001", color = { 0.005, 0.6, 1 }, material = NEON },
	{ key = "NEON_Lavanda.001", color = { 0.6, 0.22, 1 }, material = NEON },
	{ key = "NEON_Ciano", color = { 0.005, 0.42, 1 }, material = NEON },
	{ key = "NEON_Rosa", color = { 1, 0.015, 0.26 }, material = NEON },
	{ key = "NEON_Dourado", color = { 1, 0.51, 0.015 }, material = NEON },
	{ key = "NEON_Lavanda", color = { 0.5, 0.11, 1 }, material = NEON },
	{ key = "NEON_Magenta", color = { 0.85, 0.003, 0.42 }, material = NEON },
	{ key = "NEON_Ouro", color = { 1, 0.36, 0.005 }, material = NEON },
	{ key = "Texto claro", color = { 0.65, 0.77, 1 }, material = NEON },
	{ key = "Wheel_Prize", color = { 0.65, 0.77, 1 }, material = NEON },
	{ key = "Grafite", color = { 0.028, 0.019, 0.055 }, material = SMOOTH, reflectance = 0.08 },
	{ key = "Roxo el", color = { 0.16, 0.025, 0.48 }, material = SMOOTH, reflectance = 0.1 },
	{ key = "Tit", color = { 0.035, 0.008, 0.085 }, material = SMOOTH, reflectance = 0.15 },
	{ key = "Dourado", color = { 0.95, 0.55, 0.035 }, material = SMOOTH, reflectance = 0.2 },
	{ key = "Ouro", color = { 0.95, 0.43, 0.025 }, material = SMOOTH, reflectance = 0.2 },
	{ key = "Folhagem lima", color = { 0.3, 0.62, 0.012 }, material = SMOOTH },
	{ key = "Folhagem violeta", color = { 0.35, 0.018, 0.42 }, material = SMOOTH },
	{ key = "Vidro", color = { 0.055, 0.18, 0.3 }, material = Enum.Material.Glass, transparency = 0.45 },
	{ key = "Cube.4", color = { 0.008, 0.003, 0.024 }, material = SMOOTH }, -- telas para UI
}
-- setores da roleta: rosa, roxo, ciano, lavanda (repetindo)
local SECTORS = { [0] = MATERIALS[4], MATERIALS[12], MATERIALS[3], MATERIALS[6] }

local function srgb(c: { number }): Color3
	return Color3.new(c[1] ^ (1 / 2.2), c[2] ^ (1 / 2.2), c[3] ^ (1 / 2.2))
end

-- Malhas: só visual. A colisão fica nas peças simples abaixo (malhas agrupadas fechariam vãos).
for _, d in lobby.Visual:GetDescendants() do
	-- o importador deixa "é" literal nos nomes com acento
	if string.find(d.Name, "\\u00", 1, true) then
		d.Name = (d.Name:gsub("\\u00e9", "\u{e9}"):gsub("\\u00e2", "\u{e2}"))
	end
	if d.Name == "Disco UV" then
		d.Name = "Vortex" -- o LobbyFxController gira este disco
	end
	if d:IsA("BasePart") then
		d.Anchored = true
		d.CanCollide = false
		d.CanTouch = false
		d.CanQuery = false
		d.CastShadow = false
		local sector = d.Name:match("^Wheel_Sector_(%d+)")
		local mat = if sector then SECTORS[(tonumber(sector) :: number) % 4] else nil
		if not mat and d.Name ~= "Vortex" then -- o vórtice mantém a textura (SurfaceAppearance)
			for _, m in MATERIALS do
				if string.find(d.Name, m.key, 1, true) then
					mat = m
					break
				end
			end
		end
		if mat then
			d.Color = srgb(mat.color)
			d.Material = mat.material
			d.Reflectance = mat.reflectance or 0
			d.Transparency = mat.transparency or 0
		end
	end
end

local colliders = Instance.new("Folder")
colliders.Name = "Colliders"

local function collider(name: string, cf: CFrame, size: Vector3)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.CFrame = PIVOT * cf
	p.Parent = colliders
end

for _, b in BOXES do
	collider(b[1], CFrame.new(b[2]), b[3])
end
for _, r in RAMPS do
	local a, b = r[1], r[2]
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
	collider("Ramp", cf, V(r[3], 1, (b - a).Magnitude))
end
for _, r in RAILS do
	local a, b = r[1], r[2]
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, WALL_HEIGHT / 2 - 4.1, 0)
	collider("Rail", cf, V(WALL_THICKNESS, WALL_HEIGHT, (b - a).Magnitude + 0.3))
end
colliders.Parent = lobby

-- Spawns: copia o visual dos pads antigos do palco
local stage = workspace:FindFirstChild("Lobby")
local arrivals = stage and (stage:FindFirstChild("PortalArrivals") or stage:FindFirstChild("Spawns"))
assert(arrivals, "Lobby.Spawns (spawns antigos do palco) não encontrado")
local template = arrivals:FindFirstChildWhichIsA("SpawnLocation")
assert(template, "nenhum SpawnLocation em " .. arrivals:GetFullName())

local spawns = Instance.new("Folder")
spawns.Name = "Spawns"
for _, pos in SPAWNS do
	local s = template:Clone()
	s.Enabled = true
	s.CFrame = (PIVOT * CFrame.new(pos + V(0, template.Size.X / 2, 0))) * template.CFrame.Rotation
	s.Parent = spawns
end
spawns.Parent = lobby

-- Spawns antigos: viram ponto de chegada do portal (não geram personagem)
arrivals.Name = "PortalArrivals"
for _, s in arrivals:GetChildren() do
	if s:IsA("SpawnLocation") then
		s.Enabled = false
	end
end

local trigger = Instance.new("Part")
trigger.Name = "PortalTrigger"
trigger.Anchored = true
trigger.CanCollide = false
trigger.CanTouch = false
trigger.CanQuery = false
trigger.Transparency = 1
trigger.Size = V(14, 10, 4)
trigger.CFrame = PIVOT * CFrame.new(PORTAL_TRIGGER + V(0, 1.5, 0))
trigger.Parent = lobby

return string.format("SpawnLobby: %d colisores, %d spawns", #colliders:GetChildren(), #spawns:GetChildren())
